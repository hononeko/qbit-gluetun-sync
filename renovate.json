{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Bump Go version in go.mod and group it",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump",
      "groupName": "Go"
    },
    {
      "description": "Group Dockerfile Go base image updates. No release age: the tag's age resets whenever Docker Hub rebuilds it, so it would lag behind go.mod and leave the Go directive ahead of the toolchain",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": [
        "golang",
        "library/golang",
        "docker.io/library/golang"
      ],
      "matchDepNames": [
        "golang",
        "library/golang",
        "docker.io/library/golang"
      ],
      "groupName": "Go",
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Group GitHub Actions setup-go Go version updates. No release age: actions/go-versions publishes a day or two after the Go release, so it would lag behind go.mod and leave the Go directive ahead of the toolchain",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["go", "actions/go-versions"],
      "matchDepNames": ["go", "actions/go-versions"],
      "groupName": "Go",
      "minimumReleaseAge": "0 days"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    }
  ]
}